generator client {
  provider = "prisma-client-js"
}

// 연결 주소는 prisma.config.ts 에 있다.
datasource db {
  provider = "postgresql"
}

// docs/prd/05-auth.md
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique // 소문자로 정규화해 저장
  nickname     String
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  membership    Membership?
  refreshTokens RefreshToken[]
  shifts        Shift[]
  invitesUsed   Invite[]       @relation("InviteUsedBy")
  corrections   ShiftCorrection[]
  leaves        Leave[]
  subsRequested Substitution[] @relation("SubRequester")
  subsCovering  Substitution[] @relation("SubSubstitute")

  @@map("users")
}

enum RevokeReason {
  rotated
  logout
  logout_all
  session_deleted
  reuse_detected
}

// web-auth 스킬 refresh-rotation.md 의 테이블 그대로
model RefreshToken {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @map("user_id") @db.Uuid
  familyId         String        @map("family_id") @db.Uuid
  tokenHash        String        @unique @map("token_hash")
  expiresAt        DateTime      @map("expires_at") @db.Timestamptz
  sessionExpiresAt DateTime      @map("session_expires_at") @db.Timestamptz
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  revokedAt        DateTime?     @map("revoked_at") @db.Timestamptz
  revokeReason     RevokeReason? @map("revoke_reason")
  replacedBy       String?       @map("replaced_by") @db.Uuid
  userAgent        String?       @map("user_agent")
  ip               String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([familyId])
  @@index([userId])
  @@map("refresh_tokens")
}

// docs/prd/06-store-invite.md
model Store {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  lat       Float?
  lng       Float?
  fivePlus  Boolean  @default(true) @map("five_plus")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  memberships   Membership[]
  invites       Invite[]
  shifts        Shift[]
  corrections   ShiftCorrection[]
  leaves        Leave[]
  substitutions Substitution[]

  @@map("stores")
}

enum Role {
  master
  member
}

// 한 사용자는 매장 하나에만 속한다. 내보내면 행을 지우고 근무 기록은 남긴다.
model Membership {
  userId          String   @id @map("user_id") @db.Uuid
  storeId         String   @map("store_id") @db.Uuid
  role            Role
  hourlyWage      Int      @default(10320) @map("hourly_wage")
  weeklyHours     Float    @default(20) @map("weekly_hours")
  workDaysPerWeek Int      @default(5) @map("work_days_per_week")
  joinedAt        DateTime @default(now()) @map("joined_at") @db.Timestamptz

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("memberships")
}

model Invite {
  id        String    @id @default(uuid()) @db.Uuid
  storeId   String    @map("store_id") @db.Uuid
  code      String    @unique
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  usedAt    DateTime? @map("used_at") @db.Timestamptz
  usedBy    String?   @map("used_by") @db.Uuid
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  store      Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  usedByUser User? @relation("InviteUsedBy", fields: [usedBy], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@map("invites")
}

// 열린 기록(end IS NULL)은 사용자당 하나 — 마이그레이션 SQL 의 부분 유니크 인덱스가 강제한다.
model Shift {
  id        String    @id @default(uuid()) @db.Uuid
  storeId   String    @map("store_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  start     DateTime  @db.Timestamptz
  end       DateTime? @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  store       Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  corrections ShiftCorrection[]

  @@index([storeId, start])
  @@index([userId, start])
  @@map("shifts")
}

// docs/prd/08-correction-requests.md
enum RequestStatus {
  pending
  approved
  rejected
  canceled
}

enum CorrectionAction {
  edit
  add
  delete
}

// 대기 중인 요청은 기록당 하나 — 마이그레이션 SQL 의 부분 유니크 인덱스가 강제한다.
model ShiftCorrection {
  id         String           @id @default(uuid()) @db.Uuid
  storeId    String           @map("store_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  shiftId    String?          @map("shift_id") @db.Uuid
  action     CorrectionAction
  start      DateTime?        @db.Timestamptz
  end        DateTime?        @db.Timestamptz
  reason     String
  status     RequestStatus    @default(pending)
  reviewNote String?          @map("review_note")
  reviewedAt DateTime?        @map("reviewed_at") @db.Timestamptz
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz

  store Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 기록이 지워져도 요청 이력은 남긴다
  shift Shift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  @@index([storeId, status])
  @@index([userId])
  @@map("shift_corrections")
}

// docs/prd/09-leave-substitution.md
model Leave {
  id         String        @id @default(uuid()) @db.Uuid
  storeId    String        @map("store_id") @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  startDate  DateTime      @map("start_date") @db.Date
  endDate    DateTime      @map("end_date") @db.Date
  paid       Boolean
  reason     String
  status     RequestStatus @default(pending)
  createdBy  String        @map("created_by") @db.Uuid
  reviewNote String?       @map("review_note")
  reviewedAt DateTime?     @map("reviewed_at") @db.Timestamptz
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([userId, startDate])
  @@map("leaves")
}

enum SubstitutionStatus {
  requested
  accepted
  declined
  approved
  rejected
  canceled
}

model Substitution {
  id           String             @id @default(uuid()) @db.Uuid
  storeId      String             @map("store_id") @db.Uuid
  requesterId  String             @map("requester_id") @db.Uuid
  substituteId String             @map("substitute_id") @db.Uuid
  date         DateTime           @db.Date
  reason       String
  status       SubstitutionStatus @default(requested)
  reviewNote   String?            @map("review_note")
  respondedAt  DateTime?          @map("responded_at") @db.Timestamptz
  reviewedAt   DateTime?          @map("reviewed_at") @db.Timestamptz
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz

  store      Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  requester  User  @relation("SubRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  substitute User  @relation("SubSubstitute", fields: [substituteId], references: [id], onDelete: Cascade)

  @@index([storeId, status])
  @@index([requesterId, date])
  @@map("substitutions")
}

# compose.yaml 의 값과 맞춘다. 실제 .env 는 커밋하지 않는다(.gitignore).
DATABASE_URL="postgresql://timesheet:timesheet@localhost:5434/timesheet?schema=public"
PORT=4200
# 서로 다른 32바이트 이상 난수. openssl rand -base64 48
JWT_ACCESS_SECRET=
CSRF_SECRET=
# FE 출처(쉼표 구분). CSRF Origin 검사에 쓴다.
WEB_ORIGINS=http://localhost:3200
# localhost 는 브라우저가 보안 출처로 보므로 로컬에서도 true 로 둔다.
COOKIE_SECURE=true
SWAGGER_ENABLED=true
# 검증 시나리오용 (web-auth verify.md S17·S21). 평소에는 비워 둔다.
# ACCESS_TOKEN_TTL_SEC=600
# SESSION_MAX_AGE_SEC=2592000
